---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
---

<BaseLayout
  title="Terms of Service — Platinum Producers Club"
  description="PROMU Music Group Ltd. terms of service preserved for owner and legal review before production migration."
  canonicalPath="/terms/"
>
  <Header solid />
  <main id="main-content">
    <header class="legal-hero">
      <div class="page-shell">
        <p class="section-index"><span>L2</span> Legal</p>
        <h1>Promu Terms of Service</h1>
      </div>
    </header>

    <section class="legal-document" aria-label="Terms of service">
