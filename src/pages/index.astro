---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import StrategyLink from "../components/StrategyLink.astro";
import { media } from "../data/site";

const valuePoints = [
  {
    title: "Finish complete songs.",
    copy: "Move beyond unfinished ideas and build music you can actually release."
  },
  {
    title: "Raise the quality.",
    copy: "Develop the judgement behind polished, release-ready production."
  },
  {
    title: "Get clear direction.",
    copy: "Learn through focused mentorship instead of trying to solve everything alone."
  }
];

const videoTestimonials = [
  {
    name: "Carpe Dien",
    playbackId: "h019kzi7ze7GIF7te00YQJyrbQemnXOfGjFeZJeK4Tj300",
    poster: "https://image.mux.com/h019kzi7ze7GIF7te00YQJyrbQemnXOfGjFeZJeK4Tj300/thumbnail.jpg?time=86.89511133333333&width=900"
  },
  {
    name: "Alex Kade",
    playbackId: "SL66mdv00UmBbgOrgdmed0100dQY1wcHviKq8SwIVkVaoc",
    poster: "https://image.mux.com/SL66mdv00UmBbgOrgdmed0100dQY1wcHviKq8SwIVkVaoc/thumbnail.jpg?width=900"
  },
  {
    name: "Melissa Nathalia (Mòhuaika)",
    playbackId: "CEoJ8HTJD9yy438b31qgvCPtyWErmEsS3M69gjJReOM",
    poster: "https://image.mux.com/CEoJ8HTJD9yy438b31qgvCPtyWErmEsS3M69gjJReOM/thumbnail.jpg?width=900"
  }
].map((testimonial) => ({
  ...testimonial,
  player: `https://player.mux.com/${testimonial.playbackId}?metadata-video-title=${encodeURIComponent(`${testimonial.name} testimonial`)}&accent-color=%236841cc`
}));

const writtenTestimonials = [
  {
    name: "Grace Leeswadtrakul",
    quote: "His feedback is detailed, honest, and easy to apply."
  },
  {
    name: "Aaron",
    quote: "After just one month, I can already hear the difference in my tracks."
  },
  {
    name: "HEDONA",
    quote: "Within a month I had a song finished that I’m super proud of."
  }
];

const fitPoints = [
  "Producers, songwriters, and artists ready to create complete songs.",
  "Beginners who have never finished a track before.",
  "Music makers willing to learn, apply direction, and keep creating."
];
---

<BaseLayout
  title="Platinum Producers Club — Produce Release-Ready Songs"
  description="A proven mentorship helping producers, songwriters, artists, and beginners create full, release-ready songs."
>
  <Header />

  <main id="main-content">
    <section class="sales-hero" aria-labelledby="hero-title">
      <div class="page-shell sales-hero__inner">
        <header class="sales-hero__copy">
          <p class="kicker" data-reveal>Platinum Producers Club mentorship</p>
          <h1 id="hero-title" data-reveal>Produce Top-40 Level Songs In 90 Days</h1>
          <p class="sales-hero__lead" data-reveal>
            Join a proven mentorship helping producers, songwriters, and beginners create full, release-ready songs—even if you’ve never finished a track before.
          </p>
        </header>

        <div class="hero-offer" data-reveal>
          <div class="provider-video provider-video--hero" data-provider-video>
            <button
              class="provider-video__poster"
              type="button"
              aria-label="Play the current Platinum Producers Club overview"
              data-player-open
              data-player-title="Platinum Producers Club overview"
              data-player-src={media.salesVsl.embedUrl}
            >
              <img
                src={media.salesVsl.poster}
                alt="Terence Lam presenting the Platinum Producers Club mentorship"
                width="1600"
                height="900"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                referrerpolicy="strict-origin-when-cross-origin"
              />
              <span class="provider-video__shade" aria-hidden="true"></span>
              <span class="provider-video__play" aria-hidden="true"><i></i></span>
              <span class="provider-video__label"><strong>Watch the overview</strong><small>2:16 · Turn on sound</small></span>
            </button>
            <noscript><p><a href={media.salesVsl.publicUrl}>Watch the overview on Vimeo</a></p></noscript>
          </div>

          <div class="hero-offer__action">
            <StrategyLink label="Book your free strategy call" context="hero" />
          </div>
        </div>
      </div>
    </section>

    <section class="value-section section" aria-labelledby="value-title">
      <div class="page-shell">
        <header class="section-heading section-heading--center" data-reveal>
          <p class="kicker">Why the mentorship exists</p>
          <h2 id="value-title">From unfinished ideas to release-ready songs.</h2>
        </header>

        <div class="value-list">
          {valuePoints.map((point, index) => (
            <article data-reveal>
              <span>0{index + 1}</span>
              <h3>{point.title}</h3>
              <p>{point.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="results-section section" id="results" aria-labelledby="results-title">
      <div class="page-shell">
        <header class="section-heading section-heading--center" data-reveal>
          <p class="kicker">Student success stories</p>
          <h2 id="results-title">Real music makers. Real progress.</h2>
          <p>Hear from producers, songwriters, and artists who have worked through the mentorship.</p>
        </header>

        <div class="video-proof-grid">
          {videoTestimonials.map((testimonial) => (
            <figure class="video-proof" data-reveal>
              <div class="provider-video" data-provider-video>
                <button
                  class="provider-video__poster"
                  type="button"
                  aria-label={`Play ${testimonial.name}'s video testimonial`}
                  data-player-open
                  data-player-title={`${testimonial.name} video testimonial`}
                  data-player-src={testimonial.player}
                >
                  <img
                    src={testimonial.poster}
                    alt={`${testimonial.name} video testimonial poster`}
                    width="900"
                    height="506"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="strict-origin-when-cross-origin"
                  />
                  <span class="provider-video__shade" aria-hidden="true"></span>
                  <span class="provider-video__play provider-video__play--small" aria-hidden="true"><i></i></span>
                </button>
                <noscript><p><a href={testimonial.player}>Watch {testimonial.name}'s testimonial</a></p></noscript>
              </div>
              <figcaption>{testimonial.name}</figcaption>
            </figure>
          ))}
        </div>

        <div class="written-proof" role="group" aria-label="Written student testimonials">
          {writtenTestimonials.map((testimonial) => (
            <figure data-reveal>
              <blockquote>“{testimonial.quote}”</blockquote>
              <figcaption>{testimonial.name}</figcaption>
            </figure>
          ))}
        </div>

        <p class="results-disclaimer">Testimonials describe individual experiences. Results vary and are not guaranteed.</p>
      </div>
    </section>

    <section class="fit-section section" aria-labelledby="fit-title">
      <div class="page-shell fit-section__grid">
        <header class="section-heading" data-reveal>
          <p class="kicker">Who this is for</p>
          <h2 id="fit-title">Ready to take your music seriously?</h2>
          <p>Experience level matters less than your willingness to make music and use the mentorship.</p>
        </header>

        <ul class="fit-list" data-reveal>
          {fitPoints.map((point) => <li><span aria-hidden="true">✓</span>{point}</li>)}
        </ul>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-title">
      <div class="page-shell" data-reveal>
        <p class="kicker">Your next song can be different</p>
        <h2 id="final-title">Ready to make your music release-ready?</h2>
        <StrategyLink label="Book your free strategy call" context="final" />
      </div>
    </section>
  </main>
</BaseLayout>
