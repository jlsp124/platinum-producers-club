---
import { Image, Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import StrategyLink from "../components/StrategyLink.astro";
import heroPoster from "../assets/source/mentor-video-poster.jpg";
import terencePortrait from "../assets/source/current-05.png";
import abletonCredential from "../assets/source/current-06.png";

const problems = [
  {
    title: "Tutorial overload",
    copy: "You can watch hours of advice and still not know which choice is weakening your track."
  },
  {
    title: "Unfinished sessions",
    copy: "Ideas keep starting, but the same uncertainty shows up when it is time to arrange, refine, and finish."
  },
  {
    title: "More gear, same bottleneck",
    copy: "A new plugin cannot replace trained judgement, an outside ear, or a clear next move."
  }
];

const mentorshipBenefits = [
  "Detailed feedback on the music you are actually making",
  "Individual direction instead of another generic tutorial path",
  "Specific next steps you can take back into the session",
  "Workflow guidance that helps you make decisions and keep moving",
  "Accountability and perspective as your tracks develop"
];

const methodSteps = [
  {
    title: "Bring your music.",
    copy: "Start with your real sessions, references, questions, and the point where progress keeps stalling."
  },
  {
    title: "Find the bottleneck.",
    copy: "Terence listens for the decision with the highest value—whether it is arrangement, sound choice, energy, workflow, or finish."
  },
  {
    title: "Get focused direction.",
    copy: "Turn detailed feedback into practical changes and a clear plan for what to work on next."
  },
  {
    title: "Apply it and finish stronger.",
    copy: "Use the feedback in your own music while building judgement you can carry into the next record."
  }
];

const videoTestimonials = [
  {
    name: "Cedrick",
    context: "Producer · video testimonial",
    note: "In his written review, Cedrick said he completed the mentorship with greater confidence and tools to keep improving.",
    poster: "https://image.mux.com/JdlyyKMnxXeNXeYKQxuEhXVmBYqPWg3LQZvkj1imbsY/thumbnail.jpg?time=19.449666666666666&width=900",
    player: "https://player.mux.com/JdlyyKMnxXeNXeYKQxuEhXVmBYqPWg3LQZvkj1imbsY?metadata-video-title=Cedrick%20testimonial&accent-color=%236841cc"
  },
  {
    name: "Kaley Kallman",
    context: "Producer · video testimonial",
    note: "A public video testimonial shared through the Platinum Producers Club Testimonial.to wall.",
    poster: "https://image.mux.com/qOx2q4YMwErEG35wyZUskQu5gwmUm00XJhhzcmFhCVLw/thumbnail.jpg?width=900",
    player: "https://player.mux.com/qOx2q4YMwErEG35wyZUskQu5gwmUm00XJhhzcmFhCVLw?metadata-video-title=Kaley%20Kallman%20testimonial&accent-color=%236841cc"
  },
  {
    name: "Kim P.",
    context: "Producer · video testimonial",
    note: "In her written review, Kim described progressing from zero experience to four beats and a polished vocal song.",
    poster: "https://image.mux.com/vUeCbadPJNCnVebnqP1NPOnG3h02rPiY02FFCWKKO1X8U/thumbnail.jpg?width=900",
    player: "https://player.mux.com/vUeCbadPJNCnVebnqP1NPOnG3h02rPiY02FFCWKKO1X8U?metadata-video-title=Kim%20P%20testimonial&accent-color=%236841cc"
  }
];

const writtenTestimonials = [
  {
    name: "Ashtyn Keith",
    quote: "His explanations are clear and concise, and he’s really good at giving you bite-sized steps based on your needs."
  },
  {
    name: "Grace Leeswadtrakul",
    quote: "His feedback is detailed, honest, and easy to apply. Because of his guidance, I’ve improved my workflow, grown my skills, and gained confidence in myself."
  },
  {
    name: "Michell",
    quote: "He’s really good at pinpointing focus areas of improvement. You can tell that he genuinely cares about helping his students make great music."
  }
];

const fitPoints = [
  "You are making music—or are genuinely ready to start making it consistently.",
  "You want direct, detailed feedback and are willing to apply it.",
  "You are tired of piecing together random advice without a clear priority.",
  "You want to improve with the setup you already have instead of buying your way around the problem.",
  "You care about finishing stronger music, not chasing an overnight shortcut."
];

const faqs = [
  {
    question: "Do I need expensive gear or a professional studio?",
    answer: "No. PPC’s current offer is built around improving skill and decision-making without requiring a fully equipped studio. You need a workable setup for making, listening to, and exporting music—not a room full of new gear."
  },
  {
    question: "What experience level is the mentorship for?",
    answer: "The current PPC application speaks to producers from complete beginners through working producers who want to move from good to great. The strategy call is where you and Terence can confirm whether your current level and goals are a fit."
  },
  {
    question: "What happens on the strategy call?",
    answer: "It is a real one-to-one call with Terence to discuss your music, what is currently holding you back, what you want to improve, and whether the mentorship is an appropriate next step. Booking a call does not guarantee acceptance."
  },
  {
    question: "What does the mentorship cost?",
    answer: "The current public application says the mentorship may require a four-figure investment, but it does not publish a verified current price. If the fit is right, Terence can explain the current scope and investment on the call."
  },
  {
    question: "Are placements, income, or chart results guaranteed?",
    answer: "No. Mentorship can provide feedback, structure, and perspective; it cannot guarantee a placement, payment, or chart position. Student stories describe individual experiences and are not a promise of typical results."
  }
];
---

<BaseLayout
  title="Platinum Producers Club — Private Music Production Mentorship"
  description="Direct music-production feedback and private mentorship with Terence Lam for producers ready to finish stronger, release-ready music."
>
  <Header />

  <main id="main-content">
    <section class="sales-hero" aria-labelledby="hero-title">
      <div class="page-shell sales-hero__inner">
        <div class="sales-hero__copy">
          <p class="kicker" data-reveal>Private music production mentorship with Terence Lam</p>
          <h1 id="hero-title" data-reveal>Finish music you’re proud to release.</h1>
          <p class="sales-hero__lead" data-reveal>
            Replace scattered tutorials and trial-and-error with direct feedback, individual direction, and a clearer path from unfinished session to stronger record.
          </p>
        </div>

        <div class="hero-offer" data-reveal>
          <div class="provider-video provider-video--hero" data-provider-video>
            <button
              class="provider-video__poster"
              type="button"
              aria-label="Play the Platinum Producers Club program overview, 6 minutes 48 seconds"
              data-player-open
              data-player-title="Platinum Producers Club program overview"
              data-player-src="https://player.vimeo.com/video/1050034975?h=9fe7bb5ddc&dnt=1&title=0&byline=0&portrait=0&autoplay=1"
            >
              <Picture
                src={heroPoster}
                formats={["avif", "webp"]}
                widths={[640, 960, 1280]}
                sizes="(min-width: 1200px) 1120px, calc(100vw - 2rem)"
                alt="Terence Lam speaking from his music studio"
                loading="eager"
                fetchpriority="high"
                quality={86}
              />
              <span class="provider-video__shade" aria-hidden="true"></span>
              <span class="provider-video__play" aria-hidden="true"><i></i></span>
              <span class="provider-video__label"><strong>Watch the program overview</strong><small>6:48 · Sound off until you press play</small></span>
            </button>
            <noscript><p><a href="https://vimeo.com/1050034975/9fe7bb5ddc">Watch the program overview on Vimeo</a></p></noscript>
          </div>

          <div class="hero-offer__action">
            <div>
              <strong>See if mentorship fits your music.</strong>
              <p>Book a real one-to-one Release Ready Strategy Call with Terence.</p>
            </div>
            <StrategyLink label="Book your strategy session" context="hero" />
          </div>
          <p class="hero-offer__qualifier">A conversation about fit—not a guarantee of acceptance or results.</p>
        </div>
      </div>
    </section>

    <section class="problem-section section" aria-labelledby="problem-title">
      <div class="page-shell">
        <header class="section-heading section-heading--center" data-reveal>
          <p class="kicker">If this sounds familiar</p>
          <h2 id="problem-title">You don’t need more information. You need to know what your music needs next.</h2>
        </header>

        <div class="problem-list">
          {problems.map((problem) => (
            <article data-reveal>
              <h3>{problem.title}</h3>
              <p>{problem.copy}</p>
            </article>
          ))}
        </div>

        <p class="problem-section__close" data-reveal>
          You do not need a $25,000 music school or a studio full of equipment to get unstuck. You need useful feedback on the work in front of you.
        </p>
      </div>
    </section>

    <section class="mentorship-section section" id="mentorship" aria-labelledby="mentorship-title">
      <div class="page-shell split-section">
        <header class="section-heading" data-reveal>
          <p class="kicker">What changes with mentorship</p>
          <h2 id="mentorship-title">Stop guessing. Start making the next decision with purpose.</h2>
          <p>
            Platinum Producers Club is direct production mentorship built around your music—not another pile of content to work through alone.
          </p>
        </header>

        <ul class="benefit-list" data-reveal>
          {mentorshipBenefits.map((benefit) => <li><span aria-hidden="true">✓</span>{benefit}</li>)}
        </ul>
      </div>
    </section>

    <section class="coach-section section" id="terence" aria-labelledby="coach-title">
      <div class="page-shell coach-section__grid">
        <figure class="coach-portrait" data-reveal>
          <Picture
            src={terencePortrait}
            formats={["avif", "webp"]}
            widths={[320, 500]}
            sizes="(min-width: 900px) 430px, calc(100vw - 2rem)"
            alt="Terence Lam producing music at a studio keyboard"
            loading="lazy"
            quality={88}
          />
        </figure>

        <div class="coach-section__copy" data-reveal>
          <p class="kicker">Why Terence</p>
          <h2 id="coach-title">A producer’s ear. A coach’s clarity. Focused on your music.</h2>
          <p class="coach-section__lead">
            Terence “polun” Lam is a producer, coach, and Ableton Certified Trainer who turns what he hears into practical next steps you can use in the session.
          </p>

          <dl class="credential-list">
            <div><dt>15 years</dt><dd>of real-world experience stated in PPC’s current public materials</dd></div>
            <div><dt>Major-artist work</dt><dd>current PPC materials cite songs involving Drake, Alessia Cara, and Meghan Trainor</dd></div>
          </dl>

          <Image
            class="ableton-mark"
            src={abletonCredential}
            alt="Ableton Certified Trainer"
            width={490}
            quality={92}
            loading="lazy"
          />
          <p class="claim-note">Existing public PPC claims and credential; owner confirmation remains required before production migration.</p>
        </div>
      </div>
    </section>

    <section class="process-section section" id="process" aria-labelledby="process-title">
      <div class="page-shell">
        <header class="section-heading section-heading--center" data-reveal>
          <p class="kicker">How it works</p>
          <h2 id="process-title">Four simple steps. Your music stays at the centre.</h2>
        </header>

        <ol class="process-list">
          {methodSteps.map((step, index) => (
            <li data-reveal>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div><h3>{step.title}</h3><p>{step.copy}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="results-section section" id="results" aria-labelledby="results-title">
      <div class="page-shell">
        <header class="section-heading section-heading--center" data-reveal>
          <p class="kicker">Student results</p>
          <h2 id="results-title">Real producers. Real progress.</h2>
          <p>Hear directly from producers who chose to work with Terence.</p>
        </header>

        <div class="video-proof-grid">
          {videoTestimonials.map((testimonial) => (
            <figure class="video-proof" data-reveal>
              <div class="provider-video" data-provider-video>
                <button
                  class="provider-video__poster"
                  type="button"
                  aria-label={`Play ${testimonial.name}'s video testimonial`}
                  data-player-open
                  data-player-title={`${testimonial.name} video testimonial`}
                  data-player-src={testimonial.player}
                >
                  <img
                    src={testimonial.poster}
                    alt={`${testimonial.name} video testimonial poster`}
                    width="900"
                    height="506"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="strict-origin-when-cross-origin"
                  />
                  <span class="provider-video__shade" aria-hidden="true"></span>
                  <span class="provider-video__play provider-video__play--small" aria-hidden="true"><i></i></span>
                </button>
                <noscript><p><a href={testimonial.player}>Watch {testimonial.name}'s video testimonial</a></p></noscript>
              </div>
              <figcaption>
                <strong>{testimonial.name}</strong>
                <span>{testimonial.context}</span>
                <p>{testimonial.note}</p>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="written-proof" role="group" aria-label="Written student testimonials">
          {writtenTestimonials.map((testimonial) => (
            <figure data-reveal>
              <blockquote>“{testimonial.quote}”</blockquote>
              <figcaption>{testimonial.name}</figcaption>
            </figure>
          ))}
        </div>

        <p class="results-disclaimer">Testimonials describe individual experiences. Results vary and are not guaranteed.</p>

        <div class="section-conversion" data-reveal>
          <div><strong>Want focused direction on your music?</strong><p>Start with a one-to-one fit call.</p></div>
          <StrategyLink label="Book your strategy session" context="results" />
        </div>
      </div>
    </section>

    <section class="fit-section section" aria-labelledby="fit-title">
      <div class="page-shell split-section">
        <header class="section-heading" data-reveal>
          <p class="kicker">Who this is for</p>
          <h2 id="fit-title">For producers ready to make music—and use the feedback.</h2>
          <p>
            This is active mentorship. It works best when you are willing to share the work, hear an honest perspective, and put the next step into practice.
          </p>
          <p class="fit-section__note">Probably not for you if you want a guaranteed placement, income result, or one-plugin shortcut.</p>
        </header>

        <ul class="fit-list" data-reveal>
          {fitPoints.map((point) => <li><span aria-hidden="true">✓</span>{point}</li>)}
        </ul>
      </div>
    </section>

    <section class="next-step-section section" aria-labelledby="next-step-title">
      <div class="page-shell">
        <header class="section-heading section-heading--center" data-reveal>
          <p class="kicker">What happens next</p>
          <h2 id="next-step-title">The next step is a conversation—not a commitment.</h2>
        </header>

        <ol class="next-step-list">
          <li data-reveal><span>1</span><div><strong>Choose a time.</strong><p>Calendly shows Terence’s current availability in your time zone.</p></div></li>
          <li data-reveal><span>2</span><div><strong>Talk directly with Terence.</strong><p>Discuss your music, goals, current bottleneck, and the support you are looking for.</p></div></li>
          <li data-reveal><span>3</span><div><strong>Decide if it fits.</strong><p>You will determine together whether the mentorship is an appropriate next step.</p></div></li>
        </ol>

        <div class="next-step-section__action" data-reveal>
          <StrategyLink label="See available times" context="next-steps" />
          <p>Booking does not guarantee acceptance into the mentorship.</p>
        </div>
      </div>
    </section>

    <section class="faq-section section" id="faq" aria-labelledby="faq-title">
      <div class="page-shell faq-section__grid">
        <header class="section-heading" data-reveal>
          <p class="kicker">Frequently asked</p>
          <h2 id="faq-title">Questions before you book.</h2>
        </header>

        <div class="faq-list" data-reveal>
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary><strong>{faq.question}</strong><span aria-hidden="true"></span></summary>
              <div><p>{faq.answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-title">
      <div class="page-shell" data-reveal>
        <p class="kicker">Ready for a clearer next move?</p>
        <h2 id="final-title">Bring your music. Let’s talk about what it needs next.</h2>
        <StrategyLink label="Book your strategy session" context="final" />
        <p>A real one-to-one Release Ready Strategy Call with Terence Lam.</p>
      </div>
    </section>
  </main>
</BaseLayout>
