---
import ArrowIcon from "./ArrowIcon.astro";

const vimeoUrl = "https://vimeo.com/1047620937/1990c988b1";
---

<dialog class="video-dialog" id="overview-dialog" aria-labelledby="overview-dialog-title" data-video-dialog>
  <div class="video-dialog__bar">
    <div>
      <span class="eyebrow">Program overview</span>
      <h2 id="overview-dialog-title">Produce Top40 Radio Quality Music Today!</h2>
    </div>
    <button type="button" aria-label="Close video" data-video-close>
      <span></span>
      <span></span>
    </button>
  </div>
  <div
    class="video-dialog__frame"
    data-video-frame
    data-video-src="https://player.vimeo.com/video/1047620937?h=1990c988b1&dnt=1&title=0&byline=0&portrait=0&autoplay=1"
  >
    <noscript>
      <p><a href={vimeoUrl}>Watch the program overview on Vimeo <ArrowIcon /></a></p>
    </noscript>
  </div>
</dialog>

