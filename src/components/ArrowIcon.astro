---
interface Props {
  direction?: "right" | "left" | "down";
}

const { direction = "right" } = Astro.props;
---

<svg
  class:list={["arrow-icon", `arrow-icon--${direction}`]}
  aria-hidden="true"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
>
  <path d="M5 12h13M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter"></path>
</svg>

