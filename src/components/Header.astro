---
import { Image } from "astro:assets";
import ppcLogo from "../assets/source/current-01.png";
import StrategyLink from "./StrategyLink.astro";
import { withBase } from "../lib/urls";

interface Props {
  solid?: boolean;
}

const { solid = false } = Astro.props;
---

<header class:list={["site-header", { "site-header--solid": solid }]} data-site-header>
  <div class="site-header__inner">
    <a class="site-header__brand" href={withBase("/")} aria-label="Platinum Producers Club home">
      <Image
        src={ppcLogo}
        alt="Platinum Producers Club"
        width={270}
        quality={95}
        loading="eager"
        decoding="sync"
      />
    </a>
    <StrategyLink className="header-cta" label="Book a call" context="header" />
  </div>
</header>

